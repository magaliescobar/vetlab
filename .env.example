MONGODB_URI="mongodb://localhost:27017"
# Secreto de Auth.js para firmar JWTs. Generar con: npx auth secret
AUTH_SECRET="change-me"
# Requerido en producción para que Auth.js confíe en el host de las requests
# (en desarrollo se confía automáticamente).
# AUTH_TRUST_HOST="true"
# Secreto compartido para POST /api/revalidate (header x-revalidate-secret)
REVALIDATE_SECRET="change-me"
# Latencia artificial (ms) para ver el streaming de R08. 0 = desactivada.
SIMULATE_LATENCY_MS="0"
